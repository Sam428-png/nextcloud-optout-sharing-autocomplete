<template>
	<NcSettingsSection
		:name="t('autocomplete_settings', 'Autocomplete visibility')"
		:description="t('autocomplete_settings', 'Control your visibility in sharing autocomplete')"
	>
		<!-- Debug info -->
		<div style="background: #f0f0f0; padding: 10px; margin-bottom: 10px;">
			<p><strong>Debug Info:</strong></p>
			<p>optedOut: {{ optedOut }}</p>
			<p>loading: {{ loading }}</p>
			<p>saving: {{ saving }}</p>
		</div>
		
		<!-- Plain HTML checkbox test -->
		<label style="display: block; margin-bottom: 20px;">
			<input 
				type="checkbox" 
				v-model="optedOut"
				:disabled="loading || saving"
			>
			Plain HTML checkbox (test if v-model works)
		</label>
		
		<!-- Nextcloud component - Try 1: v-model -->
		<NcCheckboxRadioSwitch
			v-model="optedOut"
			:disabled="loading || saving"
			type="switch"
		>
			{{ t('autocomplete_settings', 'Hide from autocomplete suggestions (v-model)') }}
		</NcCheckboxRadioSwitch>
		
		<!-- Nextcloud component - Try 2: :checked with @update:checked -->
		<NcCheckboxRadioSwitch
			:checked="optedOut"
			:disabled="loading || saving"
			type="switch"
			@update:checked="handleManualToggle"
		>
			{{ t('autocomplete_settings', 'Hide from autocomplete suggestions (:checked)') }}
		</NcCheckboxRadioSwitch>
		
		<!-- Manual toggle button -->
		<button 
			@click="optedOut = !optedOut" 
			style="margin-top: 10px; padding: 8px 16px; cursor: pointer;"
		>
			Manual Toggle ({{ optedOut ? 'ON' : 'OFF' }})
		</button>
		
		<p v-if="saving" class="settings-hint">
			{{ t('autocomplete_settings', 'Saving...') }}
		</p>
	</NcSettingsSection>
</template>

<script>
import { ref, onMounted, watch } from 'vue'
import axios from '@nextcloud/axios'
import { showSuccess, showError } from '@nextcloud/dialogs'
import { NcSettingsSection, NcCheckboxRadioSwitch } from '@nextcloud/vue'
import { loadState } from '@nextcloud/initial-state'
import { generateUrl } from '@nextcloud/router'
import { translate as t } from '@nextcloud/l10n'

export default {
	name: 'AutocompleteSettings',
	components: {
		NcSettingsSection,
		NcCheckboxRadioSwitch,
	},
	setup() {
		const optedOut = ref(false)
		const loading = ref(true)
		const saving = ref(false)

		const loadUserPreference = () => {
			loading.value = true
			try {
				const initialValue = loadState('autocomplete_settings', 'exclude_user_from_autocomplete')
				console.log('Loaded initial value:', initialValue, typeof initialValue)
				// Handle various possible formats
				optedOut.value = initialValue === 'true' || initialValue === true || initialValue === '1' || initialValue === 1
				console.log('Set optedOut to:', optedOut.value)
			} catch (err) {
				console.error('Failed to load preference:', err)
				optedOut.value = false
			} finally {
				loading.value = false
			}
		}

		const handleToggle = async (newValue) => {
			console.log('Toggle triggered, new value:', newValue)
			
			saving.value = true

			try {
				const url = generateUrl('/apps/autocomplete_settings/settings/preference')
				console.log('Posting to:', url)
				
				const response = await axios.post(url, {
					value: newValue ? '1' : '0'
				})
				
				console.log('Response:', response.data)
				
				showSuccess(t('autocomplete_settings', 'Autocomplete preference updated'))
			} catch (err) {
				console.error('Failed to save preference:', err)
				console.error('Error details:', err.response?.data)
				showError(t('autocomplete_settings', 'Failed to save preference'))
				
				// Revert the toggle on error
				optedOut.value = !newValue
			} finally {
				saving.value = false
			}
		}

		const handleManualToggle = (newValue) => {
			console.log('Manual toggle clicked:', newValue)
			optedOut.value = newValue
			handleToggle(newValue)
		}

		// Watch for changes to optedOut
		watch(optedOut, (newValue, oldValue) => {
			// Only trigger save if not initial load
			if (!loading.value && newValue !== oldValue) {
				handleToggle(newValue)
			}
		})

		onMounted(loadUserPreference)

		return {
			optedOut,
			loading,
			saving,
			handleToggle,
			handleManualToggle,
			t,
		}
	},
}
</script>

<style lang="scss" scoped>
.settings-hint {
	color: var(--color-text-maxcontrast);
	margin-top: -10px;
	margin-bottom: 10px;
	margin-left: 30px;
}
</style>